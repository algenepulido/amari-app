{
  "name": "amari-mobile",
  "version": "1.2.5",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:dev:clear": "expo start --dev-client --clear",
    "android:dev": "expo start --dev-client --android",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "verify:security": "node ./scripts/verify-security.mjs",
    "verify:aligned-regressions": "node ./scripts/verify-aligned-regressions.mjs",
    "test:mobile-flows": "node ./scripts/verify-mobile-flows.mjs",
    "test:mobile-flows:manual": "node ./scripts/verify-mobile-flows.mjs --manual",
    "test:mobile-flows:tinashe": "node ./scripts/verify-mobile-flows.mjs --tinashe-android",
    "test:onboarding-security": "node ./scripts/verify-onboarding-security.mjs",
    "test:rls": "node ./scripts/verify-onboarding-security.mjs",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "test:watch": "jest --watch",
    "verify:release": "node ./scripts/verify-release.mjs",
    "release:prepare-copy": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-release-copy.ps1",
    "release:android": "npx eas build --platform android --profile production --non-interactive",
    "release:ios": "npx eas build --platform ios --profile production",
    "release:ios:ci": "npx eas build --platform ios --profile production --non-interactive",
    "submit:ios": "npx eas submit --platform ios --profile production --latest",
    "update:preview:android": "npx eas update --channel preview --environment preview --platform android",
    "update:preview:ios": "npx eas update --channel preview --environment preview --platform ios",
    "update:production:android": "node ./scripts/guard-production-update.mjs && npx eas update --channel production --environment production --platform android --private-key-path ./certs/private-key.pem",
    "update:production:ios": "node ./scripts/guard-production-update.mjs && npx eas update --channel production --environment production --platform ios --private-key-path ./certs/private-key.pem",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/eb-garamond": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/syne": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@rnmapbox/maps": "^10.3.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-query": "^5.90.20",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "lottie-react-native": "~7.3.1",
    "lucide-react-native": "^0.563.0",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "babel-preset-expo": "^54.0.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "lint-staged": "^16.4.0",
    "react-test-renderer": "^19.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
